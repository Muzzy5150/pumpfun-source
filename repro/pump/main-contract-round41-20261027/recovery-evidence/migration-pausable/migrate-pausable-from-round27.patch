+  let payload=match kind {1=>8,9=>0,14=>1,26=>0,_=>continue};
+  let mask=1u32<<kind;
+  if seen&mask!=0{return None}
+  seen|=mask;
+  size=size.checked_add(4)?.checked_add(payload)?;
+ }
+ Some(size)
+}
