+ let mut seen=0u32;
+ while data.len()-cursor>=2 {
+  let kind=u16::from_le_bytes([data[cursor],data[cursor+1]]);
+  if kind==0{break}
+  if data.len()-cursor<4{return None}
+  let length=u16::from_le_bytes([data[cursor+2],data[cursor+3]]) as usize;
