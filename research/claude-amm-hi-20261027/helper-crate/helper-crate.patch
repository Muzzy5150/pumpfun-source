+//! Allocation-free Token-2022 mint helpers shared by the AMM program crate.
+//!
+//! These functions are called across a crate boundary: the program's callers treat
+//! them as opaque (for example, `supported_mint` reloads the data borrow flag after the
+//! parser returns) and they are linked after the program crate's own code.
+
+/// Whether a mint's account data uses only supported Token-2022 extensions.
+pub fn supported_mint_data(data: &[u8], allow_extensions: bool) -> bool {
+    if data.len() == 82 {
+        return true;
+    }
+    if data.len() < 167 {
+        return false;
+    }
+    if data[82..165].iter().any(|byte| *byte != 0) || data[165] != 1 {
+        return false;
+    }
+    let tlv = &data[166..];
+    let mut offset = 0usize;
+    let mut seen = 0u64;
+    loop {
+        let remaining = match tlv.get(offset..) {
+            Some(remaining) => remaining,
+            None => return false,
+        };
+        if remaining.len() < 2 {
+            return true;
+        }
+        let kind = u16::from_le_bytes(remaining[..2].try_into().unwrap());
+        if kind == 0 {
+            return true;
+        }
+        if remaining.len() < 4 {
+            return false;
+        }
+        let length = u16::from_le_bytes(remaining[2..4].try_into().unwrap()) as usize;
+        let entry_size = length + 4;
+        if entry_size > remaining.len() {
+            return false;
+        }
+        if kind > 26 {
+            return false;
+        }
+        let bit = 1u64 << kind;
+        if bit & 0x0601_5052 != 0 {
+            if !allow_extensions { return false; }
+        } else if bit & 0x000c_0000 == 0 {
+            return false;
+        }
+        if seen & bit != 0 {
+            return false;
+        }
+        match kind {
+            1 => { if length < 108 { return false; } },
+            6 => { if length == 0 || remaining[4] != 1 { return false; } },
+            14 => { if length < 64 || remaining[36..68].iter().any(|byte| *byte != 0) { return false; } },
+            _ => {},
+        }
+        seen |= bit;
+        offset = match offset.checked_add(entry_size) {
+            Some(next) => next,
+            None => return false,
+        };
+    }
+}
+
+/// Native copy of one Token-2022 transfer-fee record.
+#[derive(Clone, Copy, Debug)]
+pub struct TransferFee {
+    pub epoch: u64,
+    pub maximum_fee: u64,
+    pub transfer_fee_basis_points: u16,
+}
+
+impl TransferFee {
+    /// Fee withheld when `amount` is transferred.
+    pub fn calculate_fee(&self, amount: u64) -> Option<u64> {
+        if amount == 0 {
+            return Some(0);
+        }
+        let bps = self.transfer_fee_basis_points as u128;
+        if bps == 0 {
+            Some(0)
+        } else {
+            let numerator = (amount as u128).checked_mul(bps)?;
+            let raw_fee = numerator.checked_add(10000)?.checked_sub(1)?
+                .checked_div(10000)?.try_into().ok()?;
+            Some(core::cmp::min(raw_fee, self.maximum_fee))
+        }
+    }
+
+    /// Amount to send so that `amount` arrives after the fee is withheld.
+    pub fn calculate_pre_fee_amount(&self, amount: u64) -> Option<u64> {
+        let bps = self.transfer_fee_basis_points as u128;
+        match (bps, amount) {
+            (0, _) => Some(amount),
+            (_, 0) => Some(0),
+            (10000, _) => self.maximum_fee.checked_add(amount),
+            _ => {
+                let numerator = (amount as u128).checked_mul(10000)?;
+                let denominator = 10000u128.checked_sub(bps)?;
+                let raw = numerator.checked_add(denominator)?.checked_sub(1)?
+                    .checked_div(denominator)?;
+                if raw.checked_sub(amount as u128)? >= self.maximum_fee as u128 {
+                    amount.checked_add(self.maximum_fee)
+                } else {
+                    u64::try_from(raw).ok()
+                }
+            }
+        }
+    }
+}
+
+/// Extract the epoch fee pair while validating the Token-2022 mint TLV envelope.
+pub fn decode_transfer_fees(data: &[u8]) -> Result<Option<(TransferFee, TransferFee)>, ()> {
+    if data.len() == 82 {
+        return Ok(None);
+    }
+    if data.len() < 167 || data[82..165].iter().any(|byte| *byte != 0) || data[165] != 1 {
+        return Err(());
+    }
+    let mut remaining = &data[166..];
+    let mut fees = None;
+    while remaining.len() >= 2 {
+        let kind = u16::from_le_bytes(remaining[..2].try_into().unwrap());
+        if kind == 0 {
+            break;
+        }
+        if remaining.len() < 4 {
+            return Err(());
+        }
+        let length = u16::from_le_bytes(remaining[2..4].try_into().unwrap()) as usize;
+        let value = remaining.get(4..4 + length).ok_or(())?;
+        if kind == 1 {
+            if fees.is_some() || length < 108 {
+                return Err(());
+            }
+            let read_fee = |bytes: &[u8]| TransferFee {
+                epoch: u64::from_le_bytes(bytes[..8].try_into().unwrap()),
+                maximum_fee: u64::from_le_bytes(bytes[8..16].try_into().unwrap()),
+                transfer_fee_basis_points: u16::from_le_bytes(bytes[16..18].try_into().unwrap()),
+            };
+            fees = Some((read_fee(&value[72..90]), read_fee(&value[90..108])));
+        }
+        remaining = &remaining[4 + length..];
+    }
+    Ok(fees)
+}
