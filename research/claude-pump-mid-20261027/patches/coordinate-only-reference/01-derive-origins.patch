--- a/programs/pump/src/token_incentives/init_user_volume_accumulator.rs	1969-12-31 16:00:00
+++ b/programs/pump/src/token_incentives/init_user_volume_accumulator.rs	2026-10-27 06:05:50
@@ -0,0 +1,23 @@
+use anchor_lang::prelude::*;
+
+use crate::UserVolumeAccumulator;
+
+/// Accounts for `init_user_volume_accumulator`: any payer may create the
+/// accumulator PDA of any user; an existing accumulator is left in place.
+#[event_cpi]
+#[derive(Accounts)]
+pub struct InitUserVolume<'info> {
+    #[account(mut)]
+    pub payer: Signer<'info>,
+    /// CHECK: any user may be funded by the payer.
+    pub user: AccountInfo<'info>,
+    #[account(
+        init_if_needed,
+        payer = payer,
+        space = 137,
+        seeds = [b"user_volume_accumulator", user.key().as_ref()],
+        bump
+    )]
+    pub user_volume_accumulator: Account<'info, UserVolumeAccumulator>,
+    pub system_program: Program<'info, System>,
+}

